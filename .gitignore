node_modules/
dist/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.pyc
.worktrees/
.pnpm-store/

# Estado local do skill Superpowers (brainstorming, scratch) — não é
# documentação do Atlas nem artefato de nenhuma SPEC.
.superpowers/

# Obsidian: docs/ é vault — versiona config compartilhada (app.json, plugins),
# ignora estado local de sessão/máquina
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache

# Relatórios e cache privados dos executores de agentes, gerados a partir de
# transcripts locais; não são documentação do Atlas.
.claude/usage-report.md
.codex/usage-report.md
.codex/usage-cache.json
.codex/usage-cache.lock

# Piper (SPEC-0040, ADR-0021): binário + modelos de voz não são versionados
# (Decisão D10) — só o contrato de layout (README.md) fica no git.
apps/desktop/resources/piper/*
!apps/desktop/resources/piper/README.md

# whisper.cpp (SPEC-0046, ADR-0022): binário + modelo de reconhecimento não são
# versionados — só o contrato de layout (README.md) fica no git.
apps/desktop/resources/stt/*
!apps/desktop/resources/stt/README.md

# Silero VAD (SPEC-0052, ADR-0023): runtime onnxruntime-web + binário WASM +
# modelo não são versionados — só o contrato de layout (README.md) fica no
# git.
apps/desktop/src/renderer/vendor/vad/*
!apps/desktop/src/renderer/vendor/vad/README.md
