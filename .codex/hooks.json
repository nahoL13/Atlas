{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-workflow/hook.py\" --platform codex --event PreToolUse",
            "timeout": 15,
            "statusMessage": "Verificando SPEC correspondente..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-workflow/hook.py\" --platform codex --event PostToolUse",
            "timeout": 60,
            "statusMessage": "Rodando eslint..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-workflow/hook.py\" --platform codex --event UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-workflow/hook.py\" --platform codex --event Stop",
            "timeout": 30,
            "statusMessage": "Atualizando log de uso de tokens..."
          }
        ]
      }
    ]
  }
}
